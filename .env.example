# Local dev only. In deployed environments this comes from the platform's
# own env var config, never from an uploaded .env file (see .vercelignore).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travel_booking?schema=public"

AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Not needed: auth.ts sets trustHost: true, so the app derives its own URL
# from the incoming request in both dev and production. Setting this here
# would silently override that (this bit us once already - see the
# .vercelignore comment for the story).
