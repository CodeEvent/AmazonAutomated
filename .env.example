# Local dev only. In deployed environments this comes from the platform's
# own env var config, never from an uploaded .env file (see .vercelignore).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travel_booking?schema=public"

AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Not needed: auth.ts sets trustHost: true, so the app derives its own URL
# from the incoming request in both dev and production. Setting this here
# would silently override that (this bit us once already - see the
# .vercelignore comment for the story).

# Admin panel (/admin) login — deliberately separate from the regular User
# table/NextAuth session, so a normal signup can never become an admin.
# ADMIN_PASSWORD_HASH is a bcrypt hash, not the plaintext password — generate
# one with: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
# IMPORTANT: escape every $ as \$ below — Next's env loader treats an
# unescaped $word as a reference to another env var and silently strips it,
# which corrupts a bcrypt hash (they're full of $-delimited segments).
ADMIN_EMAIL="admin@wayfarer.test"
ADMIN_PASSWORD_HASH="replace-with-a-bcrypt-hash-dollars-escaped-as-backslash-dollar"
