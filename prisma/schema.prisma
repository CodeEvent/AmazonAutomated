// Prisma schema for the travel booking platform.
// Auth models follow the shape required by @auth/prisma-adapter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  referralCode        String  @unique @default(cuid())
  marketingOptIn      Boolean @default(true)
  searchableProfile   Boolean @default(true)

  accounts       Account[]
  sessions       Session[]
  bookings       Booking[]
  reviews        Review[]
  giftCards      GiftCard[]
  coHostInquiries CoHostInquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum PropertyType {
  HOTEL
  APARTMENT
  VILLA
  RESORT
  GUEST_HOUSE
  HOSTEL
  CABIN
}

model Property {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  type         PropertyType
  description  String       @db.Text
  city         String
  country      String
  address      String
  latitude     Float
  longitude    Float
  pricePerNight Int // stored in cents (USD)
  maxGuests    Int
  bedrooms     Int
  beds         Int
  bathrooms    Int
  amenities    String[]
  unavailableAmenities String[] @default([])
  images       String[]
  houseRules   String?  @db.Text

  ratingAverage Float @default(0)
  reviewCount   Int   @default(0)

  hostId String
  host   Host   @relation(fields: [hostId], references: [id])

  roomTypes RoomType[]
  bookings  Booking[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([type])
  @@index([hostId])
}

model RoomType {
  id          String  @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name             String
  description      String? @db.Text
  maxGuests        Int
  bedConfiguration String
  sizeSqm          Int?
  pricePerNight    Int // cents
  quantity         Int     @default(1) // how many units of this room type exist
  amenities        String[] @default([])
  freeCancellation Boolean  @default(true)
  images           String[] @default([])

  // Optional breakfast upgrade, priced per night for the whole room (matches
  // how it's offered at checkout: "Add breakfast for $X" for all guests).
  // Null means this room type doesn't offer a breakfast upgrade.
  breakfastPricePerNight Int?

  bookings     Booking[]
  blockedDates BlockedDate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, name])
  @@index([propertyId])
}

/**
 * A host/admin-managed date range taken out of a room type's rentable pool
 * (maintenance, owner use, etc.). Counts against quantity exactly like a real
 * Booking — this is real availability gating, not decorative.
 */
model BlockedDate {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  reason    String?

  createdAt DateTime @default(now())

  @@index([roomTypeId])
}

model Host {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  image     String?
  bio       String? @db.Text
  education String?
  work      String?
  livesIn   String?
  languages String[] @default([])

  isSuperhost        Boolean @default(false)
  identityVerified    Boolean @default(false)
  yearsHosting        Int     @default(1)
  responseRatePercent Int     @default(95)
  ratingAverage        Float   @default(0)
  reviewCount          Int     @default(0)

  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  propertyId  String
  roomTypeId  String
  checkIn     DateTime
  checkOut    DateTime
  adults      Int           @default(1)
  children    Int           @default(0)
  infants     Int           @default(0)
  pets        Int           @default(0)
  nights      Int
  nightlyRate Int // cents, snapshot at time of booking
  cleaningFee Int // cents
  serviceFee  Int // cents
  insuranceFee Int @default(0) // cents
  totalPrice  Int // cents
  status      BookingStatus @default(CONFIRMED)
  confirmationCode String     @unique

  guestMessage      String? @db.Text
  travelInsurance   Boolean @default(false)
  payInInstallments Boolean @default(false)
  paymentMethod     String  @default("card")

  breakfastAdded Boolean @default(false)
  breakfastFee   Int     @default(0) // cents, snapshot (breakfastPricePerNight * nights)

  promoCodeId   String?
  promoCode     PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoDiscount Int        @default(0) // cents saved, snapshot

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([propertyId])
  @@index([roomTypeId])
  @@index([promoCodeId])
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

model PromoCode {
  id              String            @id @default(cuid())
  code            String            @unique
  description     String?
  discountType    PromoDiscountType
  discountValue   Int // percent (1-100) for PERCENT, cents for FIXED
  minNights       Int? // optional minimum stay requirement
  maxRedemptions  Int? // null = unlimited
  redemptionCount Int               @default(0)
  active          Boolean           @default(true)
  expiresAt       DateTime?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GiftCard {
  id      String @id @default(cuid())
  code    String @unique
  amount  Int // cents, original purchase amount
  balance Int // cents, remaining balance

  purchaserId    String
  recipientEmail String?
  recipientName  String?
  message        String? @db.Text

  purchaser User @relation(fields: [purchaserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([purchaserId])
}

model CoHostInquiry {
  id      String @id @default(cuid())
  userId  String
  city    String
  message String @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  rating     Int
  comment    String   @db.Text

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([propertyId])
}
